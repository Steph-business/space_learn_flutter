<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Requise par l'outillage Flutter en débogage : c'est par le réseau
         qu'il pose les points d'arrêt et déclenche le rechargement à chaud. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Superposition appliquée aux seuls builds de débogage.

      Elle remplace la politique réseau stricte du manifeste principal par une
      politique permissive, le temps du développement contre un backend local.
      `tools:replace` est indispensable : sans lui, la fusion des manifestes
      échoue sur l'attribut déclaré des deux côtés.

      Les builds de production ne voient jamais ce fichier.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
