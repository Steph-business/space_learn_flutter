<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Requise par l'outillage Flutter en débogage : c'est par le réseau
         qu'il pose les points d'arrêt et déclenche le rechargement à chaud. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Superposition appliquée aux seuls builds de débogage.

      Elle remplace la politique réseau du manifeste principal par celle de
      network_security_config_debug.xml, le temps du développement contre un
      backend local. La différence n'est PAS « stricte contre permissive » —
      celle de main ouvre déjà le clair pour toutes les destinations, tant que
      les serveurs répondent en http : la différence est que celle de débogage
      accepte en plus les certificats installés par l'utilisateur, donc un
      proxy d'inspection. C'est ce point-là qui ne doit jamais partir en
      production.

      `tools:replace` est indispensable : sans lui, la fusion des manifestes
      échoue sur l'attribut déclaré des deux côtés.

      Les builds de production ne voient jamais ce fichier.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
