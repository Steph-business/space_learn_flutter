<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Même dérogation qu'en debug : le profilage se fait contre le backend
         local. Sans effet réel — minSdk = 24, la network-security-config du
         manifeste principal l'emporte — mais cet attribut part le jour du
         HTTPS, en même temps que celui de src/main : voir la marche à suivre
         en tête de main/res/xml/network_security_config.xml. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
